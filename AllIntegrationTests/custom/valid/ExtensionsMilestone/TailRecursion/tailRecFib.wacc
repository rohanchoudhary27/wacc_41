# Fibonacci function done tail-recursively

# Output:
# 3
# 89
#

# Program:

begin
  int fib_tail(int n, int a, int b) is
    if n == 0 then
      return a
    else
      int next = call fib_tail(n - 1, b, a + b) ;
      return next
    fi
  end

  int fib(int n) is
    int result = call fib_tail(n, 0, 1) ;
    return result
  end

  int n1 = 4;
  int res1 = call fib(n1);
  
  int n2 = 11;
  int res2 = call fib(n2);

  println res1;
  println res2

end