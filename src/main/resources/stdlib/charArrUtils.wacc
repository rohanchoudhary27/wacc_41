# wacc.charArrUtils - Utility functions for char[] (character arrays) in WACC
#
# Note: string literals have type string, which cannot weaken to
# char[]. To work with literal text, we require a char[] literal instead
# e.g.
#   char[] s = ['h', 'e', 'l', 'l', 'o']

begin

  # Value-equality for two char arrays. Unlike ==, which is referential.
  bool equals(char[] a, char[] b) is
    int la = len a;
    int lb = len b;
    if la != lb then
      return false
    else
      skip
    fi;
    int i = 0;
    while i < la do
      if a[i] != b[i] then
        return false
      else
        skip
      fi;
      i = i + 1
    done;
    return true
  end

  # Returns true if s contains the character c.
  bool contains(char[] s, char c) is
    int length = len s;
    int i = 0;
    while i < length do
      if s[i] == c then
        return true
      else
        skip
      fi;
      i = i + 1
    done;
    return false
  end

  # Returns the index of the first occurrence of c in s, or -1 if not found.
  int indexOf(char[] s, char c) is
    int length = len s;
    int i = 0;
    while i < length do
      if s[i] == c then
        return i
      else
        skip
      fi;
      i = i + 1
    done;
    return 0 - 1
  end

  # Returns true if s starts with the given prefix.
  bool startsWith(char[] s, char[] prefix) is
    int ls = len s;
    int lp = len prefix;
    if lp > ls then
      return false
    else
      skip
    fi;
    int i = 0;
    while i < lp do
      if s[i] != prefix[i] then
        return false
      else
        skip
      fi;
      i = i + 1
    done;
    return true
  end

  # Returns true if s ends with the given suffix.
  bool endsWith(char[] s, char[] suffix) is
    int ls = len s;
    int lx = len suffix;
    if lx > ls then
      return false
    else
      skip
    fi;
    int offset = ls - lx;
    int i = 0;
    while i < lx do
      if s[offset + i] != suffix[i] then
        return false
      else
        skip
      fi;
      i = i + 1
    done;
    return true
  end

  skip
end
