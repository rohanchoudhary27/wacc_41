#!/bin/bash
# Pre-commit hook for WACC compiler project
# Runs scalafix checks on staged Scala files

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW}Running pre-commit checks...${NC}"

# Get list of staged Scala files
STAGED_SCALA_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.scala$')

if [ -z "$STAGED_SCALA_FILES" ]; then
  echo -e "${GREEN}No Scala files staged, skipping scalafix check${NC}"
  exit 0
fi

echo "Checking staged Scala files with scalafix..."

# Run scalafix on the entire project
# Note: scalafix needs full project context, so we check the whole project
# but only if there are staged Scala files
if scala-cli --power fix --check . >/dev/null 2>&1; then
  echo -e "${GREEN}✓ Scalafix checks passed${NC}"
  exit 0
else
  echo -e "${RED}✗ Scalafix checks failed${NC}"
  echo ""
  echo "Run the following to see detailed errors:"
  echo "  scala --power fix --check ."
  echo ""
  echo "To auto-fix issues (where possible):"
  echo "  scala --power fix ."
  echo ""
  echo "To commit anyway (not recommended):"
  echo "  git commit --no-verify"
  echo ""
  exit 1
fi
